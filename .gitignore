# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# Secrets (DASHSCOPE_API_KEY lives in the shell, never in a file)
.env

# Editors / OS
.vscode/
.idea/
.DS_Store

# Biometric data: enrolled face photos never leave this machine.
# Ignored at any depth, in case the folder is ever moved.
data/faces/
**/faces/**/*.jpg
**/faces/**/*.jpeg
**/faces/**/*.png

# FAIRINO SDK logs (written to the working directory)
fairino_*.log
logs/

# Generated by the evaluation battery
results/battery/battery_scratch_prefs.yaml

# Hand-eye calibration: raw capture sessions and backups (machine-specific).
# config/hand_eye.yaml itself IS committed.
data/calibration/
data/calibration_failed_*.yaml
*.bak
